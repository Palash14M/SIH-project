<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base Application Theme -->
    <style name="Theme.SmartInspection" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/surface</item>

        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/surface</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Global Typography: Sans-serif Font (Inter / System Clean) -->
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Component Styles -->
        <item name="materialCardViewStyle">@style/Widget.SmartInspection.Card</item>
        <item name="materialButtonStyle">@style/Widget.SmartInspection.Button</item>
    </style>

    <!-- Card Style (12dp rounded corners, thin 2dp elevation) -->
    <style name="Widget.SmartInspection.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Button Style (Chinese Orange, 12dp rounded corners) -->
    <style name="Widget.SmartInspection.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.SmartInspection.Splash" parent="Theme.SmartInspection">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>
</resources>
