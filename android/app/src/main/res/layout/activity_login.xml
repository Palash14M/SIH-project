<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Orange Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/primary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOVERNMENT OF INDIA"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Ministry of Social Justice\nand Empowerment"
                android:textColor="@color/surface"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Real-Time Field Monitoring &amp; Inspection Portal"
                android:textColor="@color/surface"
                android:alpha="0.9"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Main Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="-32dp"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ Direct 1-Click Role Login"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="Select any position from the dropdown menu to enter the application immediately without typing credentials."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- Server Configuration Bar -->
                <LinearLayout
                    android:id="@+id/layoutServerConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#EBF5FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvServerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌐 Server: Cloud Live (24/7)"
                        android:textColor="#1E429F"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <Button
                        android:id="@+id/btnChangeServer"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Change Server"
                        android:textSize="11sp"
                        android:textColor="@color/primary"
                        android:minWidth="0dp"
                        android:padding="2dp" />
                </LinearLayout>

                <!-- Position Dropdown (Selection enters the app immediately) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Position to Enter Directly:"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnPosition"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_spinner_border"
                    android:paddingHorizontal="@dimen/spacing_sm" />

                <!-- Position Info Banner -->
                <TextView
                    android:id="@+id/tvPositionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:background="#F0F4F8"
                    android:padding="@dimen/spacing_sm"
                    android:text="👆 Tap the dropdown above or any quick role button below to enter directly."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- OR Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginVertical="6dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  OR TAP DIRECTLY BELOW  "
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />
                </LinearLayout>

                <!-- Quick 1-Tap Role Buttons Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="4"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false"
                    android:layout_marginTop="6dp">

                    <Button
                        android:id="@+id/btnRoleMasterAdmin"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="👑 Master Admin"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#991B1B"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleInspector"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🔍 Field Inspector"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#EA580C"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleDistrict"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🏛️ District Officer"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#2563EB"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleState"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🏛️ State Officer"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#7C3AED"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleMosje"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🇮🇳 MoSJE Admin"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#0284C7"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleContractor"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🏢 Contractor"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#D97706"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRoleNgo"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="🤝 NGO Auditor"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#059669"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRolePublic"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_height="wrap_content"
                        android:layout_margin="3dp"
                        android:text="👤 Public Citizen"
                        android:textSize="11sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#4B5563"
                        android:textColor="#FFFFFF" />
                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
