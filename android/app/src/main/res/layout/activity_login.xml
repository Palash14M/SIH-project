<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Orange Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/primary"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOVERNMENT OF INDIA"
                android:textColor="@color/primary_light"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Ministry of Social Justice\nand Empowerment"
                android:textColor="@color/surface"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="Real-Time Field Monitoring &amp; Inspection Portal"
                android:textColor="@color/surface"
                android:alpha="0.9"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Main Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_lg"
            android:layout_marginTop="-32dp"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Position Login"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_headline"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:text="Select your official post from the dropdown below. Respective details will be loaded for authentication."
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- Position Dropdown (First Item) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Official Position / Post:"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spnPosition"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_spinner_border"
                    android:paddingHorizontal="@dimen/spacing_sm" />

                <!-- Position Info Banner -->
                <TextView
                    android:id="@+id/tvPositionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:background="#F0F4F8"
                    android:padding="@dimen/spacing_sm"
                    android:text="Field Inspector • Mobile &amp; Inspection Code Flow | Nagpur District"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <!-- Server Configuration Bar -->
                <LinearLayout
                    android:id="@+id/layoutServerConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#EBF5FF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <TextView
                        android:id="@+id/tvServerStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌐 Server: Cloud Live"
                        android:textColor="#1E429F"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="middle" />

                    <Button
                        android:id="@+id/btnChangeServer"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Change Server"
                        android:textSize="11sp"
                        android:textColor="@color/primary"
                        android:minWidth="0dp"
                        android:padding="2dp" />
                </LinearLayout>

                <!-- Staff Login Form -->
                <LinearLayout
                    android:id="@+id/layoutStaffLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Official Email / Username"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:text="inspector.rajesh@mosje.gov.in"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:hint="Secure Password"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        app:passwordToggleEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilTotpCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="Google / Gov Authenticator 2FA (6 digits)"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTotpCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:text="123456"
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="#FFF9C4"
                        android:padding="@dimen/spacing_xs"
                        android:text="✓ Task 12 Demo Account: Sync checks and credentials pre-loaded."
                        android:textColor="#F57F17"
                        android:textSize="@dimen/text_caption" />

                    <Button
                        android:id="@+id/btnStaffLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_lg"
                        android:text="Verify Details &amp; Enter Dashboard →"
                        style="@style/Widget.SmartInspection.Button" />
                </LinearLayout>

                <!-- Public OTP Login Form -->
                <LinearLayout
                    android:id="@+id/layoutPublicOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mobile Number"
                        app:prefixText="+91 "
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:maxLength="10"
                            android:text="9821004567" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnRequestOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Send OTP"
                        style="@style/Widget.SmartInspection.Button" />

                    <TextView
                        android:id="@+id/tvOtpHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="@color/status_warning"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:hint="Enter 6-digit OTP"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etOtp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:visibility="visible" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Verify Details &amp; Enter Dashboard →"
                        android:visibility="visible"
                        style="@style/Widget.SmartInspection.Button" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNgoRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:padding="@dimen/spacing_xs"
                    android:text="Register as New NGO / Social Auditor →"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
