<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primary"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GOVERNMENT OF INDIA • MoSJE"
                        android:textColor="@color/primary_light"
                        android:textSize="@dimen/text_small"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contractor Execution Portal"
                        android:textColor="@color/surface"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnContractorSignOut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="🚪 Sign Out"
                    android:textColor="@color/surface"
                    android:textSize="@dimen/text_small"
                    app:strokeColor="@color/surface" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvContractorBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="#20FFFFFF"
                android:paddingHorizontal="@dimen/spacing_sm"
                android:paddingVertical="3dp"
                android:text="Registered Partner: Larsen &amp; Infra Projects Ltd • REG-MH-2024-001"
                android:textColor="@color/surface"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Section 1: Ongoing Project Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvProjCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Roads &amp; Highways"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/text_caption"
                            android:textStyle="bold"
                            android:textAllCaps="true" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvProjStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/accent_warning"
                            android:paddingHorizontal="@dimen/spacing_xs"
                            android:paddingVertical="@dimen/spacing_xxs"
                            android:text="IN_PROGRESS"
                            android:textColor="@color/surface"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProjNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="TND-2026-RD-01"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/tvProjTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Four-Laning of Hingna Arterial Corridor"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProjDepartment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Public Works Department (PWD) • Nagpur, MH"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_sm"
                        android:background="@color/divider" />

                    <!-- Budget & Deadlines -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sanctioned Budget"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/tvProjSanctioned"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹4,50,00,000"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Scheduled Target"
                                android:textColor="@color/text_tertiary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/tvProjTimeline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱ 45 days left"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Physical Progress Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Verified Work Progress"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/tvProgressLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="78.5%"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbCurrentProgress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:layout_marginTop="4dp"
                            android:max="100"
                            android:progress="78"
                            android:progressTint="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Assigned Inspecting Officer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👮 Assigned Inspecting Officer"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Field Inspector designated for site audits and quality certification"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:background="#F0F4F8"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_sm">

                        <TextView
                            android:id="@+id/tvInspectorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rajesh M. (Field Inspector)"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvInspectorJurisdiction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Division: Nagpur District • Quality &amp; GPS Audit Authority"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvInspectorPhone"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📞 +91 9100000011"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnCallInspector"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:minWidth="0dp"
                                android:paddingHorizontal="@dimen/spacing_sm"
                                android:text="Call"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_caption" />

                            <Button
                                android:id="@+id/btnEmailInspector"
                                style="@style/Widget.MaterialComponents.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:minWidth="0dp"
                                android:paddingHorizontal="@dimen/spacing_sm"
                                android:text="Email"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Ongoing Project Evidence & Site Images -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📸 Ongoing Project Images &amp; Evidence"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvImageCountBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_rounded_border"
                            android:paddingHorizontal="@dimen/spacing_xs"
                            android:paddingVertical="2dp"
                            android:text="3 Photos"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Photographic progress evidence submitted for milestone verification"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <!-- Horizontal Carousel of Project Images -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutProjectImages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <Button
                        android:id="@+id/btnAddSitePhoto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="📷 Add New Project Progress Photo"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: Update Status of Completion Form -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙ Update Status of Completion"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Specify updated physical progress percentage and completed work details"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />

                    <!-- Progress Percentage Slider / Input -->
                    <TextView
                        android:id="@+id/tvSliderLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Set Completion Percentage: 78%"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbProgressPercent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:max="100"
                        android:progress="78"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />

                    <!-- Status Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="Execution State:"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spnExecutionState"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_spinner_border" />

                    <!-- Milestone Checkbox Checklist -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="Milestone Verification:"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cbMilestone1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="M1: Subgrade Compaction &amp; Soil Density (100% Done)"
                        android:textSize="@dimen/text_caption" />

                    <CheckBox
                        android:id="@+id/cbMilestone2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="M2: Bituminous Macadam Base Layer (100% Done)"
                        android:textSize="@dimen/text_caption" />

                    <CheckBox
                        android:id="@+id/cbMilestone3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="M3: Surface Wearing Course &amp; Retro-reflective Signage"
                        android:textSize="@dimen/text_caption" />

                    <!-- Work Remarks / Notes -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:hint="Contractor Progress Summary &amp; Site Notes"
                        app:boxStrokeColor="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContractorNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textMultiLine"
                            android:lines="3"
                            android:text="Road base course and side drains completed. Ready for wearing coat asphalt laying."
                            android:textColor="@color/text_primary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/btnSubmitContractorUpdate"
                        style="@style/Widget.SmartInspection.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:text="Submit Completion Update &amp; Request Inspection →" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
